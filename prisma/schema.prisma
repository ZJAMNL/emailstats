generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  CUSTOMER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role          @default(CUSTOMER)
  tenantId     String?
  tenant       Tenant?       @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Cascade)
  passwordHash String
  allWebshops  Boolean       @default(true)
  webshops     UserWebshop[]
  /// Customers (tenants) this beheerder manages; only used for ADMIN and SUPERADMIN users.
  ownedTenants Tenant[]      @relation("TenantOwner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
}

model Tenant {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  logoDataUrl      String?              @db.Text
  status           String               @default("active")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  settings         Json                 @default("{}")
  /// The beheerder responsible for this customer. Without one, only superbeheerders see it.
  ownerId          String?
  owner            User?                @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users            User[]               @relation("TenantUsers")
  campaigns        Campaign[]
  copernica        CopernicaConnection?
  selections       CopernicaSelection[]
  rfmConfig        RfmConfig?
  rfmScores        RfmProfileScore[]
  rfmSnapshots     RfmSegmentSnapshot[]
  webshops         Webshop[]
  rfmWrites        RfmWriteBack[]
  alertSettings    AlertSettings?
  alertEvents      AlertEvent[]
  predictionConfig PredictionConfig?
  predictions      ProfilePrediction[]
  insightWrites    InsightWriteBack[]

  @@index([ownerId])
}

model Campaign {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  status           String
  sentCount        Int
  openCount        Int
  clickCount       Int
  /// Unique bounces (Copernica "errors"), unsubscribes and spam complaints ("abuses").
  bounceCount      Int       @default(0)
  unsubscribeCount Int       @default(0)
  complaintCount   Int       @default(0)
  revenue          Decimal   @db.Decimal(18, 2)
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copernicaId      String
  /// Whether the customer shows and uses this campaign (Beheer → E-mailcampagnes). Hidden campaigns are kept.
  included         Boolean   @default(true)

  @@unique([tenantId, copernicaId])
  @@index([tenantId, createdAt])
  @@index([tenantId, sentAt])
  @@index([tenantId, included, sentAt])
}

model CopernicaConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  databaseId        String
  encryptedApiToken String
  connectedAt       DateTime  @default(now())
  lastSyncedAt      DateTime?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CopernicaSelection {
  id          String              @id @default(cuid())
  tenantId    String
  copernicaId String
  name        String
  enabled     Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots   SelectionSnapshot[]

  @@unique([tenantId, copernicaId])
  @@index([tenantId, enabled])
}

model SelectionSnapshot {
  id           String             @id @default(cuid())
  selectionId  String
  /// "all" for the whole database, otherwise a Webshop id.
  scope        String             @default("all")
  measuredAt   DateTime           @default(now())
  profileCount Int
  selection    CopernicaSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([selectionId, scope, measuredAt])
  @@index([selectionId, scope, measuredAt])
}

model RfmConfig {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  collectionId         String
  collectionName       String
  dateField            String
  amountField          String
  statusField          String?
  excludedStatuses     String[]  @default([])
  windowMonths         Int       @default(24)
  frequencyThresholds  Int[]     @default([1, 2, 3, 4, 5])
  marginPercent        Int       @default(100)
  enabled              Boolean   @default(false)
  customerVisible      Boolean   @default(false)
  writeBackEnabled     Boolean   @default(false)
  /// Transition: also write the old RFM_ profile fields. When switched off they are cleared in batches.
  profileFieldsEnabled Boolean   @default(true)
  /// Last write to the Copernica collection Klantinzichten (RFM and predictions together).
  insightsWriteAt      DateTime?
  insightsWriteSummary Json?
  lastRunAt            DateTime?
  lastRunStatus        String?
  lastRunSummary       Json?
  lastWriteAt          DateTime?
  lastWriteSummary     Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RfmProfileScore {
  id                 String   @id @default(cuid())
  tenantId           String
  copernicaProfileId String
  lastOrderAt        DateTime
  orderCount         Int
  revenue            Decimal  @db.Decimal(18, 2)
  r                  Int
  f                  Int
  m                  Int
  segment            String
  previousSegment    String?
  monthStartSegment  String?
  predictedClv       Decimal? @db.Decimal(18, 2)
  expectedOrders     Float?
  probabilityAlive   Float?
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, copernicaProfileId])
  @@index([tenantId, segment])
}

model RfmSegmentSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  measuredAt DateTime
  segment    String
  customers  Int
  orders     Int
  revenue    Decimal  @db.Decimal(18, 2)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, measuredAt, segment])
  @@index([tenantId, measuredAt])
}

model Webshop {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  profileField  String
  fieldValues   String[]      @default([])
  campaignTerms String[]      @default([])
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         UserWebshop[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserWebshop {
  userId    String
  webshopId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  webshop   Webshop @relation(fields: [webshopId], references: [id], onDelete: Cascade)

  @@id([userId, webshopId])
  @@index([webshopId])
}

/// What was last written to each Copernica profile, so only changes are sent and drop-outs can be cleared.
model RfmWriteBack {
  tenantId           String
  copernicaProfileId String
  hash               String
  writtenAt          DateTime
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, copernicaProfileId])
}

/// E-mail alerts for one customer: who receives the daily digest and which rules apply.
model AlertSettings {
  tenantId     String    @id
  enabled      Boolean   @default(false)
  recipients   String[]  @default([])
  /// Per rule key: { enabled, ...thresholds }. Missing keys fall back to the defaults in src/lib/alerts/rules.ts.
  rules        Json      @default("{}")
  lastDigestAt DateTime?
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// One triggered alert. Also the memory for the cooldown, so the same alert is not repeated daily.
model AlertEvent {
  id          String    @id @default(cuid())
  tenantId    String
  ruleKey     String
  /// What the alert is about (selection id, campaign id, ...), for de-duplication.
  subjectKey  String
  severity    String
  title       String
  detail      String
  value       Float?
  triggeredAt DateTime  @default(now())
  sentAt      DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ruleKey, subjectKey, triggeredAt])
  @@index([tenantId, triggeredAt])
}

/// Predictive models on order lines and web tracking. Needs the orders mapping of RfmConfig.
model PredictionConfig {
  tenantId           String    @id
  lineCollectionId   String
  lineCollectionName String
  /// Field on the order line that points to the order; matched against orderKeyField (empty = order subprofile id).
  lineOrderField     String
  orderKeyField      String    @default("")
  lineProductField   String
  lineNameField      String?
  lineCategoryField  String?
  webCollectionId    String?
  webCollectionName  String?
  webDateField       String?
  webProductField    String?
  webCategoryField   String?
  webEventField      String?
  enabled            Boolean   @default(false)
  writeBackEnabled   Boolean   @default(false)
  lastRunAt          DateTime?
  lastRunStatus      String?
  /// The backtest report (src/lib/predict/model.ts PredictionReport).
  lastRunSummary     Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ProfilePrediction {
  tenantId            String
  copernicaProfileId  String
  isBuyer             Boolean
  /// Chance of a purchase in the next 30 days; null when the model did not pass its backtest.
  purchaseProbability Float?
  intentBand          String?
  favoriteCategory    String?
  nextCategory        String?
  recommendations     String[]  @default([])
  recommendationNames String[]  @default([])
  lastVisitAt         DateTime?
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, copernicaProfileId])
  @@index([tenantId, intentBand])
}

/// One row per profile in the Copernica collection "Klantinzichten": which subprofile holds it and what was written.
model InsightWriteBack {
  tenantId           String
  copernicaProfileId String
  subprofileId       String
  hash               String
  writtenAt          DateTime
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, copernicaProfileId])
}
