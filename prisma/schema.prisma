generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role          @default(CUSTOMER)
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordHash String
  allWebshops  Boolean       @default(true)
  webshops     UserWebshop[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
}

model Tenant {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  logoDataUrl  String?              @db.Text
  status       String               @default("active")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  settings     Json                 @default("{}")
  users        User[]
  campaigns    Campaign[]
  copernica    CopernicaConnection?
  selections   CopernicaSelection[]
  rfmConfig    RfmConfig?
  rfmScores    RfmProfileScore[]
  rfmSnapshots RfmSegmentSnapshot[]
  webshops     Webshop[]
}

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  status      String
  sentCount   Int
  openCount   Int
  clickCount  Int
  revenue     Decimal   @db.Decimal(18, 2)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copernicaId String

  @@unique([tenantId, copernicaId])
  @@index([tenantId, createdAt])
}

model CopernicaConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  databaseId        String
  encryptedApiToken String
  connectedAt       DateTime  @default(now())
  lastSyncedAt      DateTime?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CopernicaSelection {
  id          String              @id @default(cuid())
  tenantId    String
  copernicaId String
  name        String
  enabled     Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots   SelectionSnapshot[]

  @@unique([tenantId, copernicaId])
  @@index([tenantId, enabled])
}

model SelectionSnapshot {
  id           String             @id @default(cuid())
  selectionId  String
  /// "all" for the whole database, otherwise a Webshop id.
  scope        String             @default("all")
  measuredAt   DateTime           @default(now())
  profileCount Int
  selection    CopernicaSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([selectionId, scope, measuredAt])
  @@index([selectionId, scope, measuredAt])
}

model RfmConfig {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  collectionId        String
  collectionName      String
  dateField           String
  amountField         String
  statusField         String?
  excludedStatuses    String[]  @default([])
  windowMonths        Int       @default(24)
  frequencyThresholds Int[]     @default([1, 2, 3, 4, 5])
  marginPercent       Int       @default(100)
  enabled             Boolean   @default(false)
  customerVisible     Boolean   @default(false)
  writeBackEnabled    Boolean   @default(false)
  lastRunAt           DateTime?
  lastRunStatus       String?
  lastRunSummary      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RfmProfileScore {
  id                 String   @id @default(cuid())
  tenantId           String
  copernicaProfileId String
  lastOrderAt        DateTime
  orderCount         Int
  revenue            Decimal  @db.Decimal(18, 2)
  r                  Int
  f                  Int
  m                  Int
  segment            String
  previousSegment    String?
  monthStartSegment  String?
  predictedClv       Decimal? @db.Decimal(18, 2)
  expectedOrders     Float?
  probabilityAlive   Float?
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, copernicaProfileId])
  @@index([tenantId, segment])
}

model RfmSegmentSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  measuredAt DateTime
  segment    String
  customers  Int
  orders     Int
  revenue    Decimal  @db.Decimal(18, 2)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, measuredAt, segment])
  @@index([tenantId, measuredAt])
}

model Webshop {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  profileField  String
  fieldValues   String[]      @default([])
  campaignTerms String[]      @default([])
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         UserWebshop[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserWebshop {
  userId    String
  webshopId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  webshop   Webshop @relation(fields: [webshopId], references: [id], onDelete: Cascade)

  @@id([userId, webshopId])
  @@index([webshopId])
}
